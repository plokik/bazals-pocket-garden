android/build/.gradle/
android/build/.cxx/
android/build/.externalNativeBuild/
android/build/build/
android/build/libs/
android/build/src/main/assets/
android/build/assetPackInstallTime/build/
android/build/captures/
android/build/local.properties
android/build/src/debug/
android/build/res/drawable/splash_icon.webp
android/build/res/mipmap*/
android/build/res/values*/godot_project_name_string.xml
android/build/res/values/themes.xml

# Never commit Android signing material
*.jks
*.keystore
*.p12
keystore.properties
